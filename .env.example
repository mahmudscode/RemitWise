# Copy to backend/.env (never commit real keys)
# PostgreSQL (recommended). If unset, a local SQLite file is used instead.
# DATABASE_URL=postgresql+psycopg://remitwise:remitwise@localhost:5432/remitwise
# Test suite against PostgreSQL (needs Docker): ./run.sh test-pg
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Accounts (see docs/21-auth-and-accounts.md)
SEED_DEMO_ACCOUNTS=true
DEMO_PASSWORD=demo1234
# Provision a real admin (admins can never self-register). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signed transaction webhook (docs/09-api-contracts.md). Leave empty to keep it disabled.
WEBHOOK_SECRET=
# Security codes are sent by email through any SMTP server. Gmail: SMTP_HOST=smtp.gmail.com, port 587, SMTP_USER=your address,
# SMTP_PASSWORD=a 16-character App Password (Google Account > Security > 2-Step Verification > App passwords), SMTP_FROM=same address.
# Check it with:  cd backend && .venv/bin/python scripts/test_email.py you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Off by default: the code is only ever emailed, never shown on screen. Set true ONLY for a demo with no email server.
OTP_DEMO_MODE=false
# Production workers and pooling (docs/production-deployment.md)
# WEB_CONCURRENCY=4
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=10
# DB_LOCK_POOL=10
