# Copy to backend/.env (never commit real keys)
# PostgreSQL (recommended). If unset, a local SQLite file is used instead.
# DATABASE_URL=postgresql+psycopg://remitwise:remitwise@localhost:5432/remitwise
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Accounts (see docs/21-auth-and-accounts.md)
SEED_DEMO_ACCOUNTS=true
DEMO_PASSWORD=demo1234
# Provision a real admin (admins can never self-register). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
